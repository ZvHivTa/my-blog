---
import { getAllPostsAndSubposts } from '@/lib/content/studies'

// Keep every previously published article URL, including chapter URLs.
export async function getStaticPaths() {
  const posts = await getAllPostsAndSubposts()
  return [
    { params: { id: undefined }, props: { destination: '/studies' } },
    { params: { id: '2' }, props: { destination: '/studies' } },
    ...posts.map((post) => ({
      params: { id: post.id },
      props: { destination: `/studies/${post.id}` },
    })),
  ]
}
return Astro.redirect(Astro.props.destination, 301)
---
