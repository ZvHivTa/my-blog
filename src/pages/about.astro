---
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const projects = await getAllProjects()
const timeline = [
  {
    period: '2025 — NOW',
    place: 'Nagoya University',
    role: 'Graduate School of Informatics',
    detail: 'Computing and Software Science',
  },
  {
    period: '2019 — 2023',
    place: 'Jinan University',
    role: 'College of Information Science and Technology',
    detail: 'Computer Science',
  },
]
---

<Layout class="about-shell max-w-6xl">
  <PageHead
    slot="head"
    title="About ZHT"
    description="Research background, current interests and selected work by ZHT."
  />
  <section class="about-hero">
    <p class="kicker">Profile / 2026</p>
    <div class="about-title">
      <h1>
        Researcher by training.<br /><span>Builder by instinct.</span>
      </h1><div class="profile-mark">ZHT<small>NAGOYA<br />JAPAN</small></div>
    </div>
    <div class="about-lead">
      <p>
        我关注形式语言、自动机学习和软件系统，也喜欢把研究之外的兴趣做成真正能用的数据产品。
      </p><p>
        这个网站记录两条并行的线：一条通向更严谨的研究，另一条通向更好用的工具。它们经常在
        AI、数据可视化和知识系统中汇合。
      </p>
    </div>
  </section>

  <section class="profile-grid">
    <div>
      <p class="kicker">Current questions</p><h2>
        What I am<br />working through.
      </h2>
    </div>
    <ol>
      <li>
        <span>01</span><div>
          <strong>Learning formal structures</strong><p>
            Can active learning go beyond minimal automata and recover richer
            algebraic structures directly?
          </p>
        </div>
      </li>
      <li>
        <span>02</span><div>
          <strong>Useful personal AI</strong><p>
            How can agents and retrieval systems become dependable research
            tools instead of generic chat interfaces?
          </p>
        </div>
      </li>
      <li>
        <span>03</span><div>
          <strong>Readable complex data</strong><p>
            How should dense game and sports data be shaped so that patterns
            become visible without losing detail?
          </p>
        </div>
      </li>
    </ol>
  </section>

  <section class="journey">
    <header>
      <p class="kicker">Background</p><h2>
        A path through<br />computer science.
      </h2>
    </header><div class="timeline">
      {
        timeline.map((item) => (
          <article>
            <>
              <time>{item.period}</time>
              <div>
                <>
                  <h3>{item.place}</h3>
                  <p>{item.role}</p>
                  <small>{item.detail}</small>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section class="project-archive">
    <header>
      <div>
        <p class="kicker">Project archive</p><h2>Selected systems.</h2>
      </div><p>
        每个项目都是一次具体探索：把领域知识、工程实现和界面表达连在一起。
      </p>
    </header>
    <div class="project-rows">
      {
        projects.map((project, index) => (
          <Link href={project.data.link} class="project-row">
            <>
              <span>0{index + 1}</span>
              <div>
                <>
                  <h3>{project.data.name}</h3>
                  <p>{project.data.tags.join(' · ')}</p>
                </>
              </div>
              <time>{project.data.startDate?.getFullYear()}</time>
              <Icon name="lucide:arrow-up-right" />
            </>
          </Link>
        ))
      }
    </div>
  </section>

  <section class="contact-line">
    <div><p class="kicker">Contact</p><h2>Let’s exchange ideas.</h2></div><div>
      <Link href="mailto:ZvHivTa@gmail.com"
        >ZvHivTa@gmail.com <Icon name="lucide:arrow-up-right" /></Link
      ><Link href="https://github.com/ZvHivTa" external
        >GitHub / ZvHivTa <Icon name="lucide:arrow-up-right" /></Link>
    </div>
  </section>
</Layout>

<style>
  :global(.about-shell) {
    gap: 0;
  }
  .kicker {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }
  .about-hero {
    padding: clamp(4rem, 10vw, 9rem) 0;
  }
  .about-title {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: end;
    margin-top: 1.5rem;
  }
  h1 {
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.055em;
  }
  h1 span {
    color: var(--muted-foreground);
    font-weight: 370;
  }
  .profile-mark {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    width: 10rem;
    aspect-ratio: 1;
    padding: 1rem;
    color: var(--accent-foreground);
    background: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.3rem;
  }
  .profile-mark small {
    font-size: 0.48rem;
    line-height: 1.4;
    text-align: right;
  }
  .about-lead {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
    max-width: 50rem;
    margin: clamp(3rem, 7vw, 6rem) 0 0 auto;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.9;
  }
  .profile-grid,
  .journey,
  .contact-line {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(3rem, 8vw, 8rem);
    padding: clamp(5rem, 10vw, 9rem) 0;
    border-top: 1px solid var(--border);
  }
  h2 {
    margin-top: 0.8rem;
    font-size: clamp(2.2rem, 4.5vw, 4.5rem);
    font-weight: 470;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .profile-grid li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1.2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }
  .profile-grid li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .profile-grid li > span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.64rem;
  }
  .profile-grid strong {
    font-size: 1.05rem;
    font-weight: 540;
  }
  .profile-grid li p {
    max-width: 40rem;
    margin-top: 0.55rem;
    color: var(--muted-foreground);
    font-size: 0.84rem;
    line-height: 1.7;
  }
  .timeline article {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.5rem;
    padding: 1.8rem 0;
    border-top: 1px solid var(--border);
  }
  .timeline article:last-child {
    border-bottom: 1px solid var(--border);
  }
  .timeline time,
  .timeline small {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }
  .timeline h3 {
    font-size: 1.35rem;
    font-weight: 520;
  }
  .timeline p {
    margin-top: 0.35rem;
    color: var(--muted-foreground);
    font-size: 0.8rem;
  }
  .timeline small {
    display: block;
    margin-top: 0.75rem;
    text-transform: uppercase;
  }
  .project-archive {
    padding: clamp(5rem, 10vw, 9rem) 0;
    border-top: 1px solid var(--border);
  }
  .project-archive > header {
    display: grid;
    grid-template-columns: 1fr 0.6fr;
    gap: 4rem;
    align-items: end;
  }
  .project-archive > header > p {
    color: var(--muted-foreground);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .project-rows {
    margin-top: 4rem;
    border-top: 1px solid var(--foreground);
  }
  .project-row {
    display: grid;
    grid-template-columns: 2rem 1fr auto 1.5rem;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .project-row > span,
  .project-row time {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }
  .project-row h3 {
    font-size: clamp(1.15rem, 2.4vw, 1.7rem);
    font-weight: 520;
  }
  .project-row p {
    margin-top: 0.35rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
  }
  .project-row :global(svg) {
    width: 1rem;
    transition: transform 0.2s;
  }
  .project-row:hover :global(svg) {
    transform: translate(0.2rem, -0.2rem);
  }
  .contact-line > div:last-child {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: end;
    gap: 1rem;
  }
  .contact-line a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--foreground);
    font-size: 0.88rem;
  }
  .contact-line :global(svg) {
    width: 1rem;
  }
  @media (max-width: 750px) {
    .about-title,
    .about-lead,
    .profile-grid,
    .journey,
    .project-archive > header,
    .contact-line {
      grid-template-columns: 1fr;
    }
    .profile-mark {
      width: 7rem;
    }
    .about-lead {
      gap: 1.3rem;
    }
    .project-row {
      grid-template-columns: 1.5rem 1fr 1rem;
    }
    .project-row time {
      display: none;
    }
  }
</style>
