---
import type { ImageMetadata } from 'astro'
import Figure from './Figure.astro'

interface Props {
  images: { src: ImageMetadata; alt: string; caption?: string }[]
  columns?: 2 | 3
  caption?: string
  crop?: boolean
  width?: 'normal' | 'wide'
}
const {
  images,
  columns = 2,
  caption,
  crop = false,
  width = 'wide',
} = Astro.props
---

<figure class:list={['content-gallery', 'not-prose', `figure-${width}`]}>
  <div class:list={['gallery-grid', { 'three-columns': columns === 3 }]}>
    {images.map((image) => <Figure {...image} crop={crop} />)}
  </div>
  {
    (caption || Astro.slots.has('caption')) && (
      <figcaption>
        <slot name="caption">{caption}</slot>
      </figcaption>
    )
  }
</figure>

<style>
  .content-gallery {
    width: 100%;
    margin: 2.5rem auto;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .three-columns {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .gallery-grid :global(.content-figure) {
    margin: 0;
  }
  figcaption {
    text-align: center;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.7;
    margin-top: 1rem;
  }
  @media (max-width: 700px) {
    .three-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .gallery-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>
