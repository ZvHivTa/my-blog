---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
  width?: 'normal' | 'wide' | 'small'
  crop?: boolean
  zoom?: boolean
}

const {
  src,
  alt,
  caption,
  width = 'normal',
  crop = false,
  zoom = true,
} = Astro.props
const widths = [
  ...new Set(
    [480, 768, 1200, 1600, src.width].filter((size) => size <= src.width),
  ),
].sort((a, b) => a - b)
const hasCaption = !!caption || Astro.slots.has('caption')
---

<figure
  class:list={[
    'content-figure',
    'not-prose',
    `figure-${width}`,
    { 'figure-crop': crop },
  ]}
>
  <image-viewer>
    {
      zoom ? (
        <button
          class="image-trigger"
          type="button"
          aria-label={`放大图片：${alt}`}
          aria-haspopup="dialog"
        >
          <Image
            src={src}
            alt={alt}
            widths={widths}
            sizes={
              width === 'small'
                ? '(max-width: 640px) 92vw, 440px'
                : '(max-width: 768px) 92vw, 1100px'
            }
            loading="lazy"
            decoding="async"
          />
          <span class="zoom-hint" aria-hidden="true">
            ↗ 放大
          </span>
        </button>
      ) : (
        <Image
          src={src}
          alt={alt}
          widths={widths}
          sizes="(max-width: 768px) 92vw, 1100px"
          loading="lazy"
          decoding="async"
        />
      )
    }
    {
      zoom && (
        <dialog aria-label={`图片查看器：${alt}`}>
          <button class="close-viewer" type="button" aria-label="关闭图片">
            关闭 ×
          </button>
          <img
            src={src.src}
            alt={alt}
            width={src.width}
            height={src.height}
            loading="lazy"
          />
          {hasCaption && (
            <div class="viewer-caption">
              <slot name="caption">{caption}</slot>
            </div>
          )}
        </dialog>
      )
    }
  </image-viewer>
  {
    hasCaption && (
      <figcaption>
        <slot name="caption">{caption}</slot>
      </figcaption>
    )
  }
</figure>

<style>
  .content-figure {
    margin: 2rem auto;
    width: 100%;
  }
  .figure-small {
    max-width: 27.5rem;
  }
  image-viewer {
    display: block;
  }
  .image-trigger {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .image-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }
  image-viewer > :global(img),
  .image-trigger :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: auto;
  }
  .figure-crop .image-trigger :global(img),
  .figure-crop image-viewer > :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .zoom-hint {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    background: rgb(0 0 0 / 65%);
    color: white;
    padding: 0.2rem 0.5rem;
    font-size: 0.7rem;
    border-radius: 2px;
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--muted-foreground);
    text-align: center;
    text-wrap: pretty;
  }
  figcaption :global(a),
  .viewer-caption :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  dialog {
    margin: auto;
    width: min(96vw, 1600px);
    max-width: 96vw;
    max-height: 94dvh;
    padding: 3.5rem 1rem 1rem;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    overflow: auto;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 82%);
  }
  dialog > img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 74dvh;
    object-fit: contain;
    margin: auto;
    display: block;
  }
  .close-viewer {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    padding: 0.65rem 1rem;
    cursor: pointer;
    border: 1px solid var(--border);
  }
  .viewer-caption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.875rem;
  }
  :global(html:has(image-viewer dialog[open])) {
    overflow: hidden;
  }
</style>

<script>
  class ImageViewer extends HTMLElement {
    private events?: AbortController
    connectedCallback() {
      this.events = new AbortController()
      const options = { signal: this.events.signal }
      const trigger = this.querySelector<HTMLButtonElement>('.image-trigger')
      const dialog = this.querySelector('dialog')
      if (!trigger || !dialog) return
      trigger.addEventListener('click', () => dialog.showModal(), options)
      this.querySelector('.close-viewer')?.addEventListener(
        'click',
        () => dialog.close(),
        options,
      )
      dialog.addEventListener(
        'click',
        (event) => {
          if (event.target !== dialog) return
          const rect = dialog.getBoundingClientRect()
          if (
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom
          )
            dialog.close()
        },
        options,
      )
      dialog.addEventListener(
        'close',
        () => trigger.focus({ preventScroll: true }),
        options,
      )
    }
    disconnectedCallback() {
      this.events?.abort()
    }
  }
  if (!customElements.get('image-viewer'))
    customElements.define('image-viewer', ImageViewer)
</script>
